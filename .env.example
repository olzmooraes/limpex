# Configurações do Supabase (Substitua pelos valores do seu projeto Supabase)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Modo de Desenvolvimento (true para usar dados locais emulados se as chaves acima estiverem vazias)
VITE_ENABLE_MOCK_FALLBACK=true

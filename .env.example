# Supabase usado pelo app (SPEC-022).
# Desenvolvimento local: rode `npm run db:start` e depois `npm run env:local`,
# que gera o .env.local com estes valores automaticamente.
# Produção (Vercel): use a Project URL e a anon/publishable key do projeto na nuvem.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key
